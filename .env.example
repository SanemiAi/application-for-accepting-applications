# ===== Настройки приложения =====
# Скопируйте этот файл в .env и при необходимости измените значения.
# Файл .env НЕ коммитится в репозиторий (см. .gitignore).

# Порт, на котором приложение будет доступно снаружи контейнера
APP_PORT=8000

# ===== База данных PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tickets
# Внешний порт PostgreSQL (нужен для локальных инструментов/migrations с хоста)
DB_PORT=5432

# Строка подключения приложения к БД (внутри docker-сети хост = db)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/tickets

# ===== Безопасность =====
# Секретный ключ подписи JWT-токенов. В продакшене ОБЯЗАТЕЛЬНО замените!
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me

# ===== Стартовый администратор =====
# Создаётся один раз при первом запуске, если в системе нет ни одного админа
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
